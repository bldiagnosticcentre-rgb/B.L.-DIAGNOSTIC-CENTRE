# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-Side Google Apps Script Web App Integration (Never expose secrets to client)
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycb.../exec"
GOOGLE_APPS_SCRIPT_SECRET="YOUR_APPS_SCRIPT_SHARED_SECRET"
